---
---
<div class="bg-background w-full px-10 lg:px-125">
    <div class="flex flex-col gap-y-10 py-20">
        <div class="flex flex-col md:flex-row gap-x-8">
            <label for="name" class="basis-full lg:basis-1/2 text-highlight font-light text-sm py-2 font-avenir">
                Nombre *
                <input type="text" id="name" name="name" class="w-full bg-white text-gray-700 py-2 border focus:border-highlight" />
            </label>
            <label for="apellido" class="basis-full lg:basis-1/2 text-highlight font-light text-sm py-2 font-avenir">
                Apellido *
                <input type="text" id="apellido" name="apellido" class="w-full bg-white text-gray-700 py-2 border focus:border-highlight" />
            </label>
        </div>
        <div class="flex flex-col md:flex-row gap-x-10">
            <label for="email" class="basis-full lg:basis-1/2 text-highlight font-light text-sm py-2 font-avenir">
                Email *
                <input type="email" id="email" name="email" class="w-full bg-white text-gray-700 py-2 border focus:border-highlight" />
            </label>
            <label for="telefono" class="basis-full lg:basis-1/2 text-highlight font-light text-sm py-2 font-avenir">
                Teléfono
                <input type="text" id="telefono" name="telefono" class="w-full bg-white text-gray-700 py-2 border focus:border-highlight" />
            </label>
        </div>
        <div class="flex flex-col gap-y-10">
            <label for="asunto" class="basis-full lg:basis-1/2 text-highlight font-light text-sm py-2 font-avenir">
                Asunto
                <input type="text" id="asunto" name="asunto" class="w-full bg-white text-gray-700 py-2 border focus:border-highlight" />
            </label>
            <label for="mensaje" class="basis-full lg:basis-1/2 text-highlight font-light text-sm py-2 font-avenir">
                Déjame un mensaje... *
                <textarea id="mensaje" name="mensaje" class="w-full bg-white text-gray-700 border focus:border-highlight" rows=5></textarea>
            </label>
        </div>
        <button>
            <span class="button button-primary px-20">
                Enviar
            </span>
        </button>
    </div>
</div>