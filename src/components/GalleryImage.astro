---
import { Image } from "astro:assets";
const { picture } = Astro.props;
---
    <Image 
        src={picture}
        alt=`picture`
        loading={"lazy"}
        format="webp"
        fit="cover"
        class="h-full w-full bg-background-2"
        quality={85}
        height={650}
        inferSize
    />