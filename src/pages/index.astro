---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Carrousel from "../components/Carrousel.astro";

import animal1 from '../assets/portfolio/animalPortrait/picture001.jpg';
import animal2 from '../assets/portfolio/animalPortrait/picture002.jpg';
import animal3 from '../assets/portfolio/animalPortrait/picture003.jpg';

import evento1 from '../assets/portfolio/events/picture001.jpg';
import evento2 from '../assets/portfolio/events/picture002.jpg';
import evento3 from '../assets/portfolio/events/picture003.jpg';

import otro1 from '../assets/portfolio/others/picture1.jpg';
import otro2 from '../assets/portfolio/others/picture2.jpg';
import otro3 from '../assets/portfolio/others/picture3.jpg';
---

<Layout pageTitle="Inicio - Hanns Guzmán">
	<Hero />
	<div id="about" class="bg-background-2 flex flex-col items-center">
		<p class="text-xl md:text-2xl lg:text-4xl font-grotesk leading-8 md:leading-12 lg:leading-15 text-justify tracking-wider px-10 md:px-30 lg:px-120 py-20">
			Soy un artista visual que trabaja mayormente a través del dibujo ilustrativo y la fotografía.
			Actualmente resido en Guatemala. Me interesa principalmente el retrato animal, la naturaleza
			y la espontaneidad de la vida.
		</p>
		<a href="/contacto">
			<div class="button button-secondary">
				Contáctame
			</div>
		</a>

		<Carrousel title="Retrato animal" 
			picture1={animal1}
			picture2={animal2}
			picture3={animal3}
		/>

		<Carrousel title="Eventos" 
			picture1={evento1}
			picture2={evento2}
			picture3={evento3}
		/>

		<Carrousel title="Otros" 
			picture1={otro1}
			picture2={otro2}
			picture3={otro3}
		/>
	</div>
</Layout>
